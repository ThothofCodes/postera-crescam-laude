# ══════════════════════════════════════════════════════════════════
# Postera Crescam Laude — Backend Environment Variables
# 1. Copy this file:  cp .env.example .env
# 2. Fill in YOUR values — never commit .env to version control
# 3. Generate JWT_SECRET:  openssl rand -base64 32
# ══════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5001

# ── MongoDB Atlas ─────────────────────────────────────────────────
# Create a free cluster at https://cloud.mongodb.com
# Replace <db_user>, <db_password>, and <cluster> with your values
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/pcl?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────
# Generate with:  openssl rand -base64 32
JWT_SECRET=<min-32-char-random-string>
JWT_EXPIRE=8h

# ── Session Timeout ───────────────────────────────────────────────
# Idle timeout in minutes — admin sessions auto-expire after this
# period of inactivity (no mouse/keyboard/touch activity).
# Backend rejects requests; frontend auto-logs out.
SESSION_IDLE_TIMEOUT_MINUTES=30

# ── Super Admin Identity Lock ─────────────────────────────────────
# Must match the email used when seeding the Super Admin account
SUPER_ADMIN_EMAIL=codeofthoth@outlook.com
CLIENT_URL=http://localhost:3000

# ── M-Pesa Daraja (Safaricom) ─────────────────────────────────────
# Register at https://developer.safaricom.co.ke
# For sandbox testing: use sandbox credentials from the developer portal
MPESA_ENV=sandbox
# Set to "production" only once you are ready to take real customer payments.
# Controls which Daraja host is used (middleware/mpesa.js + server.js CSP) —
# previously this had no effect because both were hardcoded to sandbox.
MPESA_CONSUMER_KEY=<your_consumer_key>
MPESA_CONSUMER_SECRET=<your_consumer_secret>
MPESA_SHORTCODE=<your_shortcode>
MPESA_PASSKEY=<your_passkey>
MPESA_CALLBACK_URL=https://<your-domain>/api/payments/mpesa/callback
# For sandbox testing with ngrok (auto-detected, no manual setup needed):
#   1. Start your server: node server.js
#   2. Start ngrok: ngrok http 5001
#   3. The callback URL is automatically resolved from the ngrok tunnel
#   4. Or set manually: PUT /api/payments/mpesa/callback-url { "url": "https://abc.ngrok.io" }

# ── Notifications ───────────────────────────────────────────────
# Notifications use email (nodemailer) — free via SMTP.
# Configure your SMTP credentials in the Email/SMTP section below.
# No external SMS/WhatsApp service required.

# ── MinIO Object Storage (S3-compatible) ─────────────────────────
# Self-hosted file storage — replaces Cloudinary.
# Install: https://min.io/docs/minio/linux/index.html
# Quick start: docker run -p 9000:9000 -p 9001:9001 minio/minio server /data --console-address ":9001"
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=pcl-uploads
MINIO_USE_SSL=false
# Public URL where MinIO files are accessible (set in production)
# MINIO_PUBLIC_URL=https://files.pclsolutions.co.ke

# ── Redis Cache ───────────────────────────────────────────────────
# Used for API response caching (products, dashboard stats, analytics).
# Falls back gracefully if Redis is unavailable — app works without it.
# Docker: docker run -d --name redis -p 6379:6379 redis:7-alpine
# REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_KEY_PREFIX=pcl:

# ── Email / SMTP ──────────────────────────────────────────────────
# For Gmail: enable 2FA, then create an App Password at
# https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=<your_email@gmail.com>
EMAIL_PASS=<your_gmail_app_password>

# ── Calendar (ICS Files) ─────────────────────────────────────────
# Calendar integration uses .ics files — no external API required.
# Users can download .ics files and import them into any calendar app
# (Google Calendar, Apple Calendar, Outlook, etc.).
# No configuration needed — works out of the box.

# ── CSRF Protection ────────────────────────────────────────────────
# Used to sign CSRF tokens. Falls back to JWT_SECRET if not set.
# Generate with:  openssl rand -base64 32
CSRF_SECRET=<min-32-char-random-string>

# ── LiveKit (Video Conferencing) ───────────────────────────────────
# Self-hosted or cloud — https://livekit.io
# For local dev: docker run -p 7880:7880 livekit/livekit-server
LIVEKIT_API_KEY=<your_livekit_api_key>
LIVEKIT_API_SECRET=<your_livekit_api_secret>
LIVEKIT_URL=http://localhost:7880
LIVEKIT_WS_URL=ws://localhost:7880

# ── Sanity CMS ────────────────────────────────────────────────────
# For Tech Hub content — https://sanity.io
SANITY_PROJECT_ID=<your_sanity_project_id>
SANITY_DATASET=production
SANITY_AUTH_TOKEN=<your_sanity_auth_token>

# ── ImgBB (Image Hosting) ─────────────────────────────────────────
# Free tier: https://api.imgbb.com — optional, used as fallback
IMGBB_API_KEY=<your_imgbb_api_key>

# ── Logging ────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=logs

# ── Deployment ─────────────────────────────────────────────────────
DEPLOYMENT_ENV=development

# ── Seed Script Credentials ───────────────────────────────────────
# Used ONLY by:  node seed.js
# Set strong unique passwords before running the seed script.
# These values are never used at runtime — only during initial DB setup.
SEED_SUPER_ADMIN_PASSWORD=<strong-unique-password>
SEED_ADMIN_PASSWORD=<strong-unique-password>
SEED_ADMIN_EMAIL=admin@pclsolutions.co.ke
